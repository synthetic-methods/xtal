template <iterator_q I > XTAL_DEF_(return,inline,let)    move_it(I i) noexcept -> auto {return xtd::ranges::   make_move_iterator(i);}
template <iterator_q I > XTAL_DEF_(return,inline,let) reverse_it(I i) noexcept -> auto {return xtd::ranges::make_reverse_iterator(i);}


