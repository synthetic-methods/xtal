////////////////////////////////////////////////////////////////////////////////

XTAL_DEF_(return,inline,let)
sqr(auto const &o)
noexcept -> auto
{
	return o*o;
}

template <class T>
XTAL_DEF_(let)
bit_cast = [] (auto s)
XTAL_0FN_(to) (__builtin_bit_cast(T, s));// `constexpr`!


