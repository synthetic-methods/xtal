template <class S, class  T    >	XTAL_TYP_(new)  qualify_reference                           {using type = T                  ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_reference  <S                 &, T> {using type = T                 &;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_reference  <S                &&, T> {using type = T                &&;};

template <class S, class  T    >	XTAL_TYP_(new)  qualify_volatile                            {using type = T                  ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_volatile   <S       volatile   , T> {using type = T       volatile   ;};

template <class S, class  T    >	XTAL_TYP_(new)  qualify_const                               {using type = T                  ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_const      <S const            , T> {using type = T const            ;};

template <class S, class  T    >	XTAL_TYP_(new)  qualify_cv                                  {using type = T                  ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cv         <S const            , T> {using type = T const            ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cv         <S       volatile   , T> {using type = T       volatile   ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cv         <S const volatile   , T> {using type = T const volatile   ;};

template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref                               {using type = T                  ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const            , T> {using type = T const            ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S                &&, T> {using type = T                &&;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const          &&, T> {using type = T const          &&;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S                 &, T> {using type = T                 &;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const           &, T> {using type = T const           &;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S       volatile   , T> {using type = T       volatile   ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const volatile   , T> {using type = T const volatile   ;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S       volatile &&, T> {using type = T       volatile &&;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const volatile &&, T> {using type = T const volatile &&;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S       volatile  &, T> {using type = T       volatile  &;};
template <class S, class  T    >	XTAL_TYP_(new)  qualify_cvref      <S const volatile  &, T> {using type = T const volatile  &;};

template <class S, class  T    >	XTAL_TYP_(let)  qualify_reference_t = typename qualify_reference <S, std::remove_reference_t <T>>::type;
template <class S, class  T    >	XTAL_TYP_(let)  qualify_volatile_t  = typename qualify_volatile  <S, std::remove_volatile_t  <T>>::type;
template <class S, class  T    >	XTAL_TYP_(let)  qualify_const_t     = typename qualify_const     <S, std::remove_const_t     <T>>::type;
template <class S, class  T    >	XTAL_TYP_(let)  qualify_cv_t        = typename qualify_cv        <S, std::remove_cv_t        <T>>::type;
template <class S, class  T    >	XTAL_TYP_(let)  qualify_cvref_t     = typename qualify_cvref     <S, std::remove_cvref_t     <T>>::type;


////////////////////////////////////////////////////////////////////////////////
/*!
\internal
Replaces the correspond `std` definitions,
overcoming the discrepancies between `LLVM` and `GNUC` (mainly for zero-length arrays).
*/
template <class T              >	XTAL_TYP_(new)  remove_all_extents           :  qualify_cvref<T, std::remove_all_extents_t<std::remove_cvref_t<T>>> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	XTAL_TYP_(new)  remove_all_extents  <U   [0]>:  remove_all_extents<U  > {};
template <class U              >	XTAL_TYP_(new)  remove_all_extents  <U(&)[0]>:  remove_all_extents<U &> {};
#endif
template <class U, auto     N  >	XTAL_TYP_(new)  remove_all_extents  <U   [N]>:  remove_all_extents<U  > {};
template <class U, auto     N  >	XTAL_TYP_(new)  remove_all_extents  <U(&)[N]>:  remove_all_extents<U &> {};
template <class T              >	XTAL_TYP_(let)  remove_all_extents_t         =  typename remove_all_extents<T>::type;

template <class T              >	XTAL_TYP_(new)  remove_extent                :  qualify_cvref<T, std::remove_extent_t<std::remove_cvref_t<T>>> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	XTAL_TYP_(new)  remove_extent       <U   [0]> {using type = U  ;};
template <class U              >	XTAL_TYP_(new)  remove_extent       <U(&)[0]> {using type = U &;};
#endif
template <class U, auto     N  >	XTAL_TYP_(new)  remove_extent       <U   [N]> {using type = U  ;};
template <class U, auto     N  >	XTAL_TYP_(new)  remove_extent       <U(&)[N]> {using type = U &;};
template <class T              >	XTAL_TYP_(let)  remove_extent_t              =  typename remove_extent<T>::type;

template <class T              >	XTAL_TYP_(new)         intent                :  std::integral_constant<std::size_t, 0> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	XTAL_TYP_(new)         intent       <U   [0]>:  std::integral_constant<std::size_t, 0> {};
template <class U              >	XTAL_TYP_(new)         intent       <U(&)[0]>:  std::integral_constant<std::size_t, 0> {};
#endif
template <class U, auto     N  >	XTAL_TYP_(new)         intent       <U   [N]>:  std::integral_constant<std::size_t, N> {};
template <class U, auto     N  >	XTAL_TYP_(new)         intent       <U(&)[N]>:  std::integral_constant<std::size_t, N> {};

template <class T, unsigned N=0>	XTAL_TYP_(new)         extent                :  extent<remove_extent_t<T>, N - 1> {};
template <class T              >	XTAL_TYP_(new)         extent       <T,   0U>:  intent<T> {};
template <class T, unsigned N=0>	XTAL_DEF_(let)         extent_v              =  extent<T, N>::value;


////////////////////////////////////////////////////////////////////////////////

template <class T              >	XTAL_TYP_(ask)    nominally_initializable    =  std::              default_initializable   <std::remove_cvref_t<T>>;
template <class T              >	XTAL_TYP_(ask)    trivially_initializable    =  std:: is_trivially_default_constructible_v <std::remove_cvref_t<T>>;

template <class T              >	XTAL_TYP_(ask)    nominally_destructible     =  std::                    is_destructible_v <std::remove_cvref_t<T>>;
template <class T              >	XTAL_TYP_(ask)    trivially_destructible     =  std::          is_trivially_destructible_v <std::remove_cvref_t<T>>;

template <class T              >	XTAL_TYP_(ask)    nominally_copyable         =  std::               is_copy_constructible_v<std::remove_cvref_t<T>> and
                                                                                 std::               is_copy_assignable_v   <std::remove_cvref_t<T>>;
template <class T              >	XTAL_TYP_(ask)    trivially_copyable         =  std::     is_trivially_copy_constructible_v<std::remove_cvref_t<T>> and
                                                                                 std::     is_trivially_copy_assignable_v   <std::remove_cvref_t<T>>;

template <class T              >	XTAL_TYP_(ask)    nominally_movable          =  std::               is_move_constructible_v<std::remove_cvref_t<T>> and
                                                                                 std::               is_move_assignable_v   <std::remove_cvref_t<T>>;
template <class T              >	XTAL_TYP_(ask)    trivially_movable          =  std::     is_trivially_move_constructible_v<std::remove_cvref_t<T>> and
                                                                                 std::     is_trivially_move_assignable_v   <std::remove_cvref_t<T>>;

template <class T              >	XTAL_TYP_(ask)    nominally_constructible    =  nominally_copyable<T> and nominally_movable<T>;
template <class T              >	XTAL_TYP_(ask)    trivially_constructible    =  trivially_copyable<T> and trivially_movable<T>;

template <class T              >	XTAL_TYP_(ask)    nominally_instructible     =  nominally_destructible<T> and nominally_initializable<T>;
template <class T              >	XTAL_TYP_(ask)    trivially_instructible     =  trivially_destructible<T> and trivially_initializable<T>;

template <class T              >	XTAL_TYP_(ask)    nominal                    =  nominally_instructible<T> and nominally_constructible<T>;
template <class T              >	XTAL_TYP_(ask)    trivial                    =  trivially_instructible<T> and trivially_constructible<T>;

template <class F, class ..._s >	XTAL_TYP_(ask)              invocable        =  requires {XTAL_ANY_(F) (XTAL_ANY_(_s)...);};
template <class F              >	XTAL_TYP_(ask)              evaluable        =  requires {F{} == F{}();};
template <class F, class ..._s >	XTAL_TYP_(ask)    trivially_invocable        =  trivially_initializable<F> and invocable<F, _s...>;
template <class F              >	XTAL_TYP_(ask)    trivially_evaluable        =  trivially_invocable    <F> and evaluable<F       >;


////////////////////////////////////////////////////////////////////////////////

template <class  T             >	XTAL_TYP_(ask)                      rvalue   =      std::is_rvalue_reference_v<T>;
template <class  T             >	XTAL_TYP_(ask)                      lvalue   =      std::is_lvalue_reference_v<T>;
template <class  T             >	XTAL_TYP_(ask)              mutable_rvalue   =      std::same_as<std::remove_cvref_t<T>       &&, T>;
template <class  T             >	XTAL_TYP_(ask)              mutable_lvalue   =      std::same_as<std::remove_cvref_t<T>        &, T>;
template <class  T             >	XTAL_TYP_(ask)            immutable_rvalue   =      std::same_as<std::remove_cvref_t<T> const &&, T>;
template <class  T             >	XTAL_TYP_(ask)            immutable_lvalue   =      std::same_as<std::remove_cvref_t<T> const  &, T>;

template <class  T             >	XTAL_TYP_(ask)  immutable_reference          =      std::    is_const_v<T>;
template <class  T             >	XTAL_TYP_(ask)    mutable_reference          =  not std::    is_const_v<T>;
template <class  T             >	XTAL_TYP_(ask)            reference          =      std::is_reference_v<T>;
template <class  T             >	XTAL_TYP_(new)          dereference          :      std::remove_reference<T> {};
template <class  T             >	XTAL_TYP_(new)          dereference_rvalue                    {using type = T;};
template <class  T             >	XTAL_TYP_(new)          dereference_lvalue                    {using type = T;};
template <rvalue T             >	XTAL_TYP_(new)          dereference_rvalue<T>:                dereference<T> {};
template <lvalue T             >	XTAL_TYP_(new)          dereference_lvalue<T>:                dereference<T> {};

template <class  T             >	XTAL_TYP_(let)          dereference_t        =  typename        dereference<T>::type;
template <class  T             >	XTAL_TYP_(let)          dereference_rvalue_t =  typename dereference_rvalue<T>::type;
template <class  T             >	XTAL_TYP_(let)          dereference_lvalue_t =  typename dereference_lvalue<T>::type;

template <class  T             >	XTAL_TYP_(ask)              nominal_xvalue   =  nominal<T> or  rvalue<T>;
template <class  T             >	XTAL_TYP_(ask)              nominal_rvalue   =  nominal<T> and rvalue<T>;
template <class  T             >	XTAL_TYP_(ask)              nominal_lvalue   =  nominal<T> and lvalue<T>;

template <class  T             >	XTAL_TYP_(ask)              trivial_xvalue   =  trivial<T> or  rvalue<T>;
template <class  T             >	XTAL_TYP_(ask)              trivial_rvalue   =  trivial<T> and rvalue<T>;
template <class  T             >	XTAL_TYP_(ask)              trivial_lvalue   =  trivial<T> and lvalue<T>;

template <class  T             >	XTAL_TYP_(new)                decay            {using type = std::remove_cvref_t<T>; using value_type = std::remove_cvref_t<T>;};
template <class  T             >	XTAL_TYP_(new)                decay_xvalue     {using type = std::remove_cvref_t<T>; using value_type = std::remove_cvref_t<T>;};
template <lvalue T             >	XTAL_TYP_(new)                decay_xvalue<T>  {using type =                     T ; using value_type = decltype(&XTAL_ANY_(T));};
template <class  T             >	XTAL_TYP_(new)        decay_nominal_xvalue   :  decay_xvalue <T> {};
template <class  T             >	XTAL_TYP_(new)        decay_trivial_xvalue   :  decay_xvalue <T> {};
template <nominal_lvalue T     >	XTAL_TYP_(new)        decay_nominal_xvalue<T>:  decay        <T> {};
template <trivial_lvalue T     >	XTAL_TYP_(new)        decay_trivial_xvalue<T>:  decay        <T> {};

template <class  T             >	XTAL_TYP_(let)                decay_t        =  typename         decay       <T>::type;
template <class  T             >	XTAL_TYP_(let)                decay_xvalue_t =  typename         decay_xvalue<T>::type;
template <class  T             >	XTAL_TYP_(let)        decay_nominal_xvalue_t =  typename decay_nominal_xvalue<T>::type;
template <class  T             >	XTAL_TYP_(let)        decay_trivial_xvalue_t =  typename decay_trivial_xvalue<T>::type;


