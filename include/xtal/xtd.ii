template <class T              >	XTAL_TYP_(new)   signed_case                 : std::          make_signed<T             >  {};
template <                     >	XTAL_TYP_(new)   signed_case<XTAL_STD_flt_2> : std::          make_signed<XTAL_STD_int_2>  {};
template <                     >	XTAL_TYP_(new)   signed_case<XTAL_STD_flt_3> : std::          make_signed<XTAL_STD_int_3>  {};
template <                     >	XTAL_TYP_(new)   signed_case<XTAL_STD_flt_4> : std::          make_signed<XTAL_STD_int_4>  {};
template <class T              >	XTAL_TYP_(let)   signed_case_t               = typename       signed_case<XTAL_NOM_(T)>::type;

template <class T              >	XTAL_TYP_(new) unsigned_case                 : std::        make_unsigned<T             >  {};
template <                     >	XTAL_TYP_(new) unsigned_case<XTAL_STD_flt_2> : std::        make_unsigned<XTAL_STD_int_2>  {};
template <                     >	XTAL_TYP_(new) unsigned_case<XTAL_STD_flt_3> : std::        make_unsigned<XTAL_STD_int_3>  {};
template <                     >	XTAL_TYP_(new) unsigned_case<XTAL_STD_flt_4> : std::        make_unsigned<XTAL_STD_int_4>  {};
template <class T              >	XTAL_TYP_(let) unsigned_case_t               = typename     unsigned_case<XTAL_NOM_(T)>::type;

template <class T=void>
XTAL_DEF_(return,inline,let)
signed_cast(auto const f)
noexcept -> auto
{
	using F = XTAL_ALL_(f);
	if constexpr (same_type_as<T, void> or same_size_as<T, F>) {
		XTAL_IF0
		XTAL_0IF (    trivially_evaluable<F>) {return   signed_cast                    (f());}
		XTAL_0IF (std::   signed_integral<F>) {return                                   f   ;}
		XTAL_0IF (std:: unsigned_integral<F>) {return      bit_cast<  signed_case_t<F>>(f)  ;}
		XTAL_0IF_(else)                       {return   static_cast<  signed_case_t<F>>(f)  ;}
	}
	else {
		return static_cast<signed_case_t<T>>(signed_cast(f));
	}
}
template <class T=void>
XTAL_DEF_(return,inline,let)
unsigned_cast(auto const f)
noexcept -> auto
{
	using F = XTAL_ALL_(f);
	if constexpr (same_type_as<T, void> or same_size_as<T, F>) {
		XTAL_IF0
		XTAL_0IF (    trivially_evaluable<F>) {return unsigned_cast                    (f());}
		XTAL_0IF (std:: unsigned_integral<F>) {return                                   f   ;}
		XTAL_0IF (std::   signed_integral<F>) {return      bit_cast<unsigned_case_t<F>>(f)  ;}
		XTAL_0IF_(else)                       {return   static_cast<unsigned_case_t<F>>(f)  ;}
	}
	else {
		return unsigned_cast(signed_cast<T>(f));
	}
}


////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

template <class T
,	int Nm=sizeof(T)*(8) - (sqr(std::countr_zero(sizeof(T)) + 4) >> 2)
,	int Nx=sizeof(T)*(8) - Nm - 1
,	int Nz=1
>
struct bit_flop;

template <std::floating_point T, int Nm, int Nx, int Nz>
struct bit_flop<T, Nm, Nx, Nz>
{
private:
	using U  = unsigned_case_t<T>;

public:
	using value_type = T;
	using valve_type = U;

	template <U N_shift, U N_depth, U N_range=U{1} << N_depth>
	struct field_type
	{
		XTAL_DEF_(set) shift = N_shift;
		XTAL_DEF_(set) depth = N_depth;
		XTAL_DEF_(set) range = N_range;
		XTAL_DEF_(set) mark  = range - U{1};
		XTAL_DEF_(set) mask  = mark << shift;

	};
	static constexpr field_type<0          , Nm       > mantissa{};
	static constexpr field_type<0 + Nm     , Nx       > exponent{};
	static constexpr field_type<0 + Nm     , Nx - U{1}>     unit{};
	static constexpr field_type<0 + Nm + Nx, Nz       >     sign{};

	U mantissa_part : Nm = Nm;
	U exponent_part : Nx = Nx;
	U     sign_part : Nz = Nz;

	XTAL_DEF_(let) operator() ()
	const noexcept {return bit_cast<T>(*this);}

	XTAL_NEW_(explicit)
	bit_flop(T o)
	noexcept(false)
	:	bit_flop{bit_cast<U>(XTAL_MOV_(o))}
	{}
	XTAL_NEW_(explicit)
	bit_flop(U o)
	noexcept(false)
	:	mantissa_part{o&mantissa.mask >> mantissa.shift}
	,	exponent_part{o&exponent.mask >> exponent.shift}
	,	    sign_part{o&    sign.mask >>     sign.shift}
	{/*this = bit_cast<W>(XTAL_REF_(o))*/}

	XTAL_NEW_(delete) (bit_flop, noexcept=default)
	XTAL_NEW_(create) (bit_flop, noexcept=default)
	XTAL_NEW_(move)   (bit_flop, noexcept=default)
	XTAL_NEW_(copy)   (bit_flop, noexcept=default)

};
template <std::integral T, int Nm, int Nx, int Nz> requires same_size_as<XTAL_STD_flt_2, T>
struct         bit_flop<T,     Nm,     Nx,     Nz> :         bit_flop   <XTAL_STD_flt_2, Nm, Nx, Nz> {};

template <std::integral T, int Nm, int Nx, int Nz> requires same_size_as<XTAL_STD_flt_3, T>
struct         bit_flop<T,     Nm,     Nx,     Nz> :         bit_flop   <XTAL_STD_flt_3, Nm, Nx, Nz> {};


XTAL_DEF_(return,inline,let)
bit_floss(auto &&v)
noexcept -> decltype(auto)
{
	using  W = bit_flop<std::remove_cvref_t<decltype(v)>>;
	return reinterpret_cast<qualify_cvref_t<decltype(v), W>>(XTAL_REF_(v));
}


////////////////////////////////////////////////////////////////////////////////
/*!
\brief   Combinines the magnitude of `t` with the sign_part-bit of `s`.
\note    Uses `__builtin_copysign` to provide `constexpr` evaluation,
         but guaranteed to preserve type.
*/
template <std::floating_point T, class S>
XTAL_DEF_(return,inline,let)
XTAL_NYM_(copysign) (T const t, S const s)
noexcept -> T
{
	using U = unsigned_case_t<T>;
	XTAL_IF0
	XTAL_0IF (sizeof(T) != sizeof(S) and std::floating_point<XTAL_NOM_(T)>) {
		return XTAL_NYM_(copysign) (t, (T) s);
	}
	XTAL_0IF (sizeof(T) != sizeof(S) and std::integral      <XTAL_NOM_(S)>) {
		return XTAL_NYM_(copysign) (t, signed_cast<T>(s));
	}
	XTAL_0IF (sizeof(T) == sizeof(__builtin_copysign(t, s))) {
		return __builtin_copysign(t, s);
	}
	XTAL_0IF_(else) {
		U constexpr  positive_mask = ~U{} >> 1, sign_mask = ~positive_mask;
		U const t_ = positive_mask&bit_cast<U>(t);
		U const s_ =     sign_mask&bit_cast<U>(s);
		return bit_cast<T>(XTAL_MOV_(t_)|XTAL_MOV_(s_));
	}
};
XTAL_DEF_(let) copysign = [] XTAL_1FN_(call) (XTAL_NYM_(copysign));
static_assert(same_type_as<float, XTAL_ALL_(copysign(1.F, 1.F))>);


////////////////////////////////////////////////////////////////////////////////

template <std::floating_point F>
XTAL_DEF_(return,inline,set)
ldexp(F f, signed_case_t<F> x)
noexcept -> auto
{
	using K = bit_flop<F>;
	XTAL_IF1_(consteval) {
		return f*bit_cast<F>(K::unit.mark + x << K::unit.shift);
	}
	XTAL_0IF_(else) {
		//\
		bit_floss(f).exponent_part += x;
		reinterpret_cast<unsigned_case_t<F> &>(f) += x << K::unit.shift;
		return f;
	}
}


////////////////////////////////////////////////////////////////////////////////
/*!
\returns The result of `w + x*(y*...*ys)`, using `fma` where possible.
\note    May be extended via ADL.
*/
template <class T=void>
struct plus_multiplies;

template <>
struct plus_multiplies<void>
{
	XTAL_DEF_(return,inline,let)
	operator() (auto &&w, auto &&x, auto &&y) const
	noexcept -> XTAL_ALL_(w + x*y)
	{
		using Z = XTAL_ALL_(w + x*y);
		XTAL_IF0
		XTAL_0IF_(consteval) {
			return                              XTAL_REF_(y)* XTAL_REF_(x)+ XTAL_REF_(w)  ;
		}
	#if   XTAL_SYS_(FMA) and XTAL_SYS_(builtin)
		XTAL_0IF     (requires {{__builtin_fma(y, x, w)} -> same_type_as<Z>;}) {
			return                __builtin_fma(XTAL_REF_(y), XTAL_REF_(x), XTAL_REF_(w)) ;
		}
		XTAL_0IF     (requires {{__builtin_fma(y, x, w)}                   ;}) {
			return static_cast<Z>(__builtin_fma(XTAL_REF_(y), XTAL_REF_(x), XTAL_REF_(w)));
		}
	#endif
	#if   XTAL_SYS_(FMA)
		XTAL_0IF     (requires {{          fma(y, x, w)} -> same_type_as<Z>;}) {
			return                          fma(XTAL_REF_(y), XTAL_REF_(x), XTAL_REF_(w)) ;
		}
		XTAL_0IF     (requires {{          fma(y, x, w)}                    ;}) {
			return static_cast<Z>(          fma(XTAL_REF_(y), XTAL_REF_(x), XTAL_REF_(w)));
		}
	#endif
		XTAL_0IF_(else) {
			return                              XTAL_REF_(y)* XTAL_REF_(x)+ XTAL_REF_(w)  ;
		}
	}
	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (V const &w, std::complex<V> const &x, V const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w, x.real(), y)
		,	x.imag()*y
		};}
	}
	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (V const &w, V const &x, std::complex<V> const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w, x, y.real())
		,	x*y.imag()
		};}
	}

	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (std::complex<V> const &w, V const &x, V const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w.real(), x, y)
		,	w.imag()
		};}
	}

	XTAL_DEF_(return,inline,let)
	operator() (auto &&w, auto &&x, auto &&y, auto &&...ys) const
	noexcept -> auto
	requires (1 <= sizeof...(ys))
	{
		return operator() (XTAL_REF_(w), XTAL_REF_(x), (XTAL_REF_(y) *...* XTAL_REF_(ys)));
	}

};
template <class T>
struct plus_multiplies
{
	template <class W, class ...Xs>
	XTAL_DEF_(return,inline,let)
	operator() (W &&w, Xs &&...xs) const
	noexcept -> auto
	{
		static_assert((std::convertible_to<W, T> and...and std::convertible_to<Xs, T>));
		return plus_multiplies<void>{}.operator() (XTAL_REF_(w), XTAL_REF_(xs)...);
	}

};

template <class T=void> using multiplies = std::multiplies<T>;
template <class T=void> using       plus = std::      plus<T>;


////////////////////////////////////////////////////////////////////////////////

template <class T=void>
struct real
{
private:
	using U = XTAL_NOM_(T);

public:
	XTAL_DEF_(return,inline,let)
	operator() (auto &&u) const
	noexcept -> auto
	requires std::same_as<U, void> or std::same_as<U, XTAL_ALL_(u)>
	{
		std::real(XTAL_REF_(u));
	}

};
template <class T=void>
struct imag
{
private:
	using U = XTAL_NOM_(T);

public:
	XTAL_DEF_(return,inline,let)
	operator() (auto &&u) const
	noexcept -> auto
	requires std::same_as<U, void> or std::same_as<U, XTAL_ALL_(u)>
	{
		std::imag(XTAL_REF_(u));
	}

};


