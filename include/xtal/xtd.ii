////////////////////////////////////////////////////////////////////////////////

template <class T, class ...Ts> concept same_as      = (...and std::same_as<          T ,           Ts >);
template <class T, class ...Ts> concept same_type_as = (...and std::same_as<XTAL_NOM_(T), XTAL_NOM_(Ts)>);
template <class T, class ...Ts> concept same_size_as = (...and (sizeof(T) == sizeof(Ts)));


////////////////////////////////////////////////////////////////////////////////

template <class S, class T >	struct  qualify_reference                           {using type = T                  ;};
template <class S, class T >	struct  qualify_reference  <S                 &, T> {using type = T                 &;};
template <class S, class T >	struct  qualify_reference  <S                &&, T> {using type = T                &&;};
template <class S, class T >	using   qualify_reference_t = typename qualify_reference      <S, T>::type;

template <class S, class T >	struct  qualify_volatile                            {using type = T                  ;};
template <class S, class T >	struct  qualify_volatile   <S       volatile   , T> {using type = T       volatile   ;};
template <class S, class T >	using   qualify_volatile_t  = typename qualify_volatile       <S, T>::type;

template <class S, class T >	struct  qualify_const                               {using type = T                  ;};
template <class S, class T >	struct  qualify_const      <S const            , T> {using type = T const            ;};
template <class S, class T >	using   qualify_const_t     = typename qualify_const          <S, T>::type;

template <class S, class T >	struct  qualify_cv                                  {using type = T                  ;};
template <class S, class T >	struct  qualify_cv         <S const            , T> {using type = T const            ;};
template <class S, class T >	struct  qualify_cv         <S       volatile   , T> {using type = T       volatile   ;};
template <class S, class T >	struct  qualify_cv         <S const volatile   , T> {using type = T const volatile   ;};
template <class S, class T >	using   qualify_cv_t        = typename qualify_cv             <S, T>::type;

template <class S, class T >	struct  qualify_cvref                               {using type = T                  ;};
template <class S, class T >	struct  qualify_cvref      <S const            , T> {using type = T const            ;};
template <class S, class T >	struct  qualify_cvref      <S                &&, T> {using type = T                &&;};
template <class S, class T >	struct  qualify_cvref      <S const          &&, T> {using type = T const          &&;};
template <class S, class T >	struct  qualify_cvref      <S                 &, T> {using type = T                 &;};
template <class S, class T >	struct  qualify_cvref      <S const           &, T> {using type = T const           &;};
template <class S, class T >	struct  qualify_cvref      <S       volatile   , T> {using type = T       volatile   ;};
template <class S, class T >	struct  qualify_cvref      <S const volatile   , T> {using type = T const volatile   ;};
template <class S, class T >	struct  qualify_cvref      <S       volatile &&, T> {using type = T       volatile &&;};
template <class S, class T >	struct  qualify_cvref      <S const volatile &&, T> {using type = T const volatile &&;};
template <class S, class T >	struct  qualify_cvref      <S       volatile  &, T> {using type = T       volatile  &;};
template <class S, class T >	struct  qualify_cvref      <S const volatile  &, T> {using type = T const volatile  &;};
template <class S, class T >	using   qualify_cvref_t     = typename qualify_cvref          <S, T>::type;


////////////////////////////////////////////////////////////////////////////////
/*!
\internal
Replaces the correspond `std` definitions,
overcoming the discrepancies between `LLVM` and `GNUC` (mainly for zero-length arrays).
*/
template <class T              >	struct  remove_all_extents : qualify_cvref<T, std::remove_all_extents_t<std::remove_cvref_t<T>>> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	struct  remove_all_extents<U   [0]> : remove_all_extents<U  > {};
template <class U              >	struct  remove_all_extents<U(&)[0]> : remove_all_extents<U &> {};
#endif
template <class U,     auto N  >	struct  remove_all_extents<U   [N]> : remove_all_extents<U  > {};
template <class U,     auto N  >	struct  remove_all_extents<U(&)[N]> : remove_all_extents<U &> {};
template <class T              >	using   remove_all_extents_t = typename remove_all_extents<T>::type;

template <class T              >	struct  remove_extent : qualify_cvref<T, std::remove_extent_t<std::remove_cvref_t<T>>> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	struct  remove_extent<U   [0]> {using type = U  ;};
template <class U              >	struct  remove_extent<U(&)[0]> {using type = U &;};
#endif
template <class U,     auto N  >	struct  remove_extent<U   [N]> {using type = U  ;};
template <class U,     auto N  >	struct  remove_extent<U(&)[N]> {using type = U &;};
template <class T              >	using   remove_extent_t = typename remove_extent<T>::type;

template <class T              >	struct        _extent          : std::integral_constant<std::size_t, 0> {};
#if XTAL_VER_(MSVC == 0)
template <class U              >	struct        _extent<U   [0]> : std::integral_constant<std::size_t, 0> {};
template <class U              >	struct        _extent<U(&)[0]> : std::integral_constant<std::size_t, 0> {};
#endif
template <class U,     auto N  >	struct        _extent<U   [N]> : std::integral_constant<std::size_t, N> {};
template <class U,     auto N  >	struct        _extent<U(&)[N]> : std::integral_constant<std::size_t, N> {};

template <class T, unsigned N=0>	struct         extent          :  extent<remove_extent_t<T>, N - 1> {};
template <class T              >	struct         extent<T, 0U>   : _extent<T> {};
template <class T, unsigned N=0>	auto constexpr extent_v =         extent<T, N>::value;


////////////////////////////////////////////////////////////////////////////////

template <class T> concept nominally_initializable = std::               default_initializable  <T>;
//\
template <class T> concept nominally_destructible  = std::            is_nothrow_destructible_v <T>;
template <class T> concept nominally_destructible  = std::                       destructible   <T>;
template <class T> concept nominally_copyable      = std::                       copyable       <T>;
template <class T> concept nominally_movable       = std::                       movable        <T>;

template <class T> concept trivially_initializable = std:: is_trivially_default_constructible_v <T>;
template <class T> concept trivially_destructible  = std:: is_trivially_destructible_v          <T>;
template <class T> concept trivially_copyable      = std:: is_trivially_copyable_v              <T>;
template <class T> concept trivially_movable       = std:: is_trivially_move_constructible_v    <T>\
                                                 and std:: is_trivially_move_assignable_v       <T>;

template <class T> concept nominally_constructible = nominally_copyable<T> and nominally_movable<T>;
template <class T> concept trivially_constructible = trivially_copyable<T> and trivially_movable<T>;

template <class T> concept nominally_instructible  = nominally_destructible<T> and nominally_initializable<T>;
template <class T> concept trivially_instructible  = trivially_destructible<T> and trivially_initializable<T>;

template <class T> concept nominal                 = nominally_instructible<T> and nominally_constructible<T>;
template <class T> concept trivial                 = trivially_instructible<T> and trivially_constructible<T>;


////////////////////////////////////////////////////////////////////////////////

template <class T, class S> concept             derived_from =                             std::derived_from<T, S>;
template <class T, class S> concept    strictly_derived_from = not same_type_as<T, S> and std::derived_from<T, S>;


////////////////////////////////////////////////////////////////////////////////

template <class T           > concept                  reference =       std::is_reference_v<T>;
template <class T           > concept          mutable_reference =  not std::    is_const_v<T>;
template <class T           > concept        immutable_reference =       std::    is_const_v<T>;

template <class T           > concept           rvalue_reference = std::is_rvalue_reference_v<T>;
template <class T           > concept           lvalue_reference = std::is_lvalue_reference_v<T>;
template <class T           > concept   mutable_rvalue_reference = std::same_as<std::remove_cvref_t<T>       &&, T>;
template <class T           > concept   mutable_lvalue_reference = std::same_as<std::remove_cvref_t<T>        &, T>;
template <class T           > concept immutable_rvalue_reference = std::same_as<std::remove_cvref_t<T> const &&, T>;
template <class T           > concept immutable_lvalue_reference = std::same_as<std::remove_cvref_t<T> const  &, T>;

template <class T           > struct        remove_reference    : std::remove_reference<T> {};
template <class T           > struct remove_rvalue_reference                 {using type = T;};
template <class T           > struct remove_lvalue_reference                 {using type = T;};
//\
template <rvalue_reference T> struct remove_rvalue_reference<T> :      std::remove_cvref<T> {};
template <rvalue_reference T> struct remove_rvalue_reference<T> :       remove_reference<T> {};
template <lvalue_reference T> struct remove_lvalue_reference<T> :       remove_reference<T> {};

template <class T           > using         remove_reference_t = typename        remove_reference<T>::type;
template <class T           > using  remove_rvalue_reference_t = typename remove_rvalue_reference<T>::type;
template <class T           > using  remove_lvalue_reference_t = typename remove_lvalue_reference<T>::type;

//\
static_assert(std::same_as<remove_rvalue_reference_t<const float(&&)[2]>,       float    [2]>);
static_assert(std::same_as<remove_rvalue_reference_t<const float(&&)[2]>, const float    [2]>);
static_assert(std::same_as<remove_lvalue_reference_t<const float(&&)[2]>, const float(&&)[2]>);
static_assert(std::same_as<remove_rvalue_reference_t<const float( &)[2]>, const float( &)[2]>);
static_assert(std::same_as<remove_lvalue_reference_t<const float( &)[2]>, const float    [2]>);


template <class T> concept      nominal_value_reference = nominal<std::remove_cvref_t<T>> or  rvalue_reference<T>;
template <class T> concept     nominal_rvalue_reference = nominal<std::remove_cvref_t<T>> and rvalue_reference<T>;
template <class T> concept     nominal_lvalue_reference = nominal<std::remove_cvref_t<T>> and lvalue_reference<T>;

template <class T> concept      trivial_value_reference = trivial<std::remove_cvref_t<T>> or  rvalue_reference<T>;
template <class T> concept     trivial_rvalue_reference = trivial<std::remove_cvref_t<T>> and rvalue_reference<T>;
template <class T> concept     trivial_lvalue_reference = trivial<std::remove_cvref_t<T>> and lvalue_reference<T>;


template <class T>
struct    decay_value
{
	using value_type = std::remove_cvref_t<T>;
	using       type = std::remove_cvref_t<T>;

};
template <class T>
struct decay_value_reference : decay_value<T>
{
};
template <lvalue_reference T>
struct decay_value_reference<T>
{
	//\
	using value_type = std::shared_ptr<XTAL_NOM_(T)>;
	using value_type = decltype(&XTAL_ANY_(T));
	using       type = T;

};
template <                   class T>	struct decay_nominal_value_reference    : decay_value_reference <T> {};
template <nominal_lvalue_reference T>	struct decay_nominal_value_reference<T> : decay_value           <T> {};

template <                   class T>	struct decay_trivial_value_reference    : decay_value_reference <T> {};
template <trivial_lvalue_reference T>	struct decay_trivial_value_reference<T> : decay_value           <T> {};

template <class T           > using                    decay_value_t = typename                   decay_value<T>::type;
template <class T           > using          decay_value_reference_t = typename         decay_value_reference<T>::type;
template <class T           > using  decay_nominal_value_reference_t = typename decay_nominal_value_reference<T>::type;
template <class T           > using  decay_trivial_value_reference_t = typename decay_trivial_value_reference<T>::type;


////////////////////////////////////////////////////////////////////////////////

template <class T             > concept             rational =     std::floating_point<XTAL_NOM_(T)>;
template <class T             > concept             integral =     std::      integral<XTAL_NOM_(T)>;
template <class T             > concept          disintegral = not std::      integral<XTAL_NOM_(T)>;

template <class F, class ...Xs> concept            invocable = requires {XTAL_ANY_(F) (XTAL_ANY_(Xs)...);};
template <class F, class ...Xs> concept   constant_invocable = trivially_initializable<F> and invocable<F, Xs...>;
template <class F             > concept constant_equivocable = disintegral<F> and constant_invocable<F> and requires {F{} == F{}();};


////////////////////////////////////////////////////////////////////////////////

template <class T>
XTAL_DEF_(let)
bit_cast = [] (auto s)
XTAL_0FN_(to) (__builtin_bit_cast(T, s));// `constexpr`!


////////////////////////////////////////////////////////////////////////////////

template <class T>
struct bit_flop;

template <>
struct bit_flop<XTAL_STD_flt_2>
{
	using value_type = XTAL_STD_flt_2;
	using field_type = XTAL_STD_nat_2;

	static constexpr field_type FRACTION = 23; field_type fraction : FRACTION = FRACTION;
	static constexpr field_type EXPONENT =  8; field_type exponent : EXPONENT = EXPONENT;
	static constexpr field_type     SIGN =  1; field_type     sign :     SIGN =     SIGN;
	static constexpr field_type     ZERO =  0;
	static constexpr field_type      ONE =  1;
	static constexpr field_type     UNIT =  EXPONENT - 1;
	static constexpr field_type     unit =  ((field_type) 1 << UNIT) - 1;

	XTAL_DEF_(let) operator() ()
	const noexcept {return bit_cast<value_type>(*this);}

	XTAL_NEW_(explicit)
	bit_flop(value_type o)
	noexcept(false)
	:	bit_flop{bit_cast<field_type>(XTAL_MOV_(o))}
	{}
	XTAL_NEW_(explicit)
	bit_flop(field_type o)
	noexcept(false)
	:	fraction{(o >>                       ZERO)&((ONE << FRACTION) - ONE)}
	,	exponent{(o >>            FRACTION + ZERO)&((ONE << EXPONENT) - ONE)}
	,	    sign{(o >> EXPONENT + FRACTION + ZERO)&((ONE <<     SIGN) - ONE)}
	{/*this = bit_cast<W>(XTAL_REF_(o))*/}

	XTAL_NEW_(delete) (bit_flop, noexcept=default)
	XTAL_NEW_(create) (bit_flop, noexcept=default)
	XTAL_NEW_(move)   (bit_flop, noexcept=default)
	XTAL_NEW_(copy)   (bit_flop, noexcept=default)

};
template <>
struct bit_flop<XTAL_STD_flt_3>
{
	using value_type = XTAL_STD_flt_3;
	using field_type = XTAL_STD_nat_3;

	static constexpr field_type FRACTION = 52; field_type fraction : FRACTION = FRACTION;
	static constexpr field_type EXPONENT = 11; field_type exponent : EXPONENT = EXPONENT;
	static constexpr field_type     SIGN =  1; field_type     sign :     SIGN =     SIGN;
	static constexpr field_type     ZERO =  0;
	static constexpr field_type      ONE =  1;
	static constexpr field_type     UNIT =  EXPONENT - 1;
	static constexpr field_type     unit =  ((field_type) 1 << UNIT) - 1;

	XTAL_DEF_(let) operator() ()
	const noexcept {return bit_cast<value_type>(*this);}

	XTAL_NEW_(explicit)
	bit_flop(value_type o)
	noexcept(false)
	:	bit_flop{bit_cast<field_type>(XTAL_MOV_(o))}
	{}
	XTAL_NEW_(explicit)
	bit_flop(field_type o)
	noexcept(false)
	:	fraction{(o >>                       ZERO)&((ONE << FRACTION) - ONE)}
	,	exponent{(o >>            FRACTION + ZERO)&((ONE << EXPONENT) - ONE)}
	,	    sign{(o >> EXPONENT + FRACTION + ZERO)&((ONE <<     SIGN) - ONE)}
	{/*this = bit_cast<W>(XTAL_REF_(o))*/}

	XTAL_NEW_(delete) (bit_flop, noexcept=default)
	XTAL_NEW_(create) (bit_flop, noexcept=default)
	XTAL_NEW_(move)   (bit_flop, noexcept=default)
	XTAL_NEW_(copy)   (bit_flop, noexcept=default)

};

template <same_size_as<XTAL_STD_flt_2> T>
struct bit_flop<T> : bit_flop<XTAL_STD_flt_2> {};

template <same_size_as<XTAL_STD_flt_3> T>
struct bit_flop<T> : bit_flop<XTAL_STD_flt_3> {};


XTAL_DEF_(return,inline,let)
bit_floss(auto &&v)
noexcept -> decltype(auto)
{
	using  W = bit_flop<std::remove_cvref_t<decltype(v)>>;
	return reinterpret_cast<qualify_cvref_t<decltype(v), W>>(XTAL_REF_(v));
}


////////////////////////////////////////////////////////////////////////////////

template <class T> struct    signed_case                 : std::          make_signed<T             >  {};
template <       > struct    signed_case<XTAL_STD_flt_2> : std::          make_signed<XTAL_STD_int_2>  {};
template <       > struct    signed_case<XTAL_STD_flt_3> : std::          make_signed<XTAL_STD_int_3>  {};
template <       > struct    signed_case<XTAL_STD_flt_4> : std::          make_signed<XTAL_STD_int_4>  {};
template <class T> using     signed_case_t               = typename       signed_case<XTAL_NOM_(T)>::type;

template <class T> struct  unsigned_case                 : std::        make_unsigned<T             >  {};
template <       > struct  unsigned_case<XTAL_STD_flt_2> : std::        make_unsigned<XTAL_STD_int_2>  {};
template <       > struct  unsigned_case<XTAL_STD_flt_3> : std::        make_unsigned<XTAL_STD_int_3>  {};
template <       > struct  unsigned_case<XTAL_STD_flt_4> : std::        make_unsigned<XTAL_STD_int_4>  {};
template <class T> using   unsigned_case_t               = typename     unsigned_case<XTAL_NOM_(T)>::type;

template <class T=void>
XTAL_DEF_(return,inline,let)
signed_cast(auto const f)
noexcept -> auto
{
	using F = XTAL_ALL_(f);
	if constexpr (same_type_as<T, void> or same_size_as<T, F>) {
		XTAL_IF0
		XTAL_0IF (   constant_equivocable<F>) {return          signed_cast    (f());}
		XTAL_0IF (std::   signed_integral<F>) {return                                 f   ;}
		XTAL_0IF (std:: unsigned_integral<F>) {return    bit_cast<  signed_case_t<F>>(f)  ;}
		XTAL_0IF_(else)                       {return static_cast<  signed_case_t<F>>(f)  ;}
	}
	else {
		return static_cast<signed_case_t<T>>(signed_cast(f));
	}
}
template <class T=void>
XTAL_DEF_(return,inline,let)
unsigned_cast(auto const f)
noexcept -> auto
{
	using F = XTAL_ALL_(f);
	if constexpr (same_type_as<T, void> or same_size_as<T, F>) {
		XTAL_IF0
		XTAL_0IF (   constant_equivocable<F>) {return             unsigned_cast    (f());}
		XTAL_0IF (std:: unsigned_integral<F>) {return                                 f   ;}
		XTAL_0IF (std::   signed_integral<F>) {return    bit_cast<unsigned_case_t<F>>(f)  ;}
		XTAL_0IF_(else)                       {return static_cast<unsigned_case_t<F>>(f)  ;}
	}
	else {
		return unsigned_cast(signed_cast<T>(f));
	}
}


////////////////////////////////////////////////////////////////////////////////
/*!
\brief   Combinines the magnitude of `t` with the sign-bit of `s`.
\note    Uses `__builtin_copysign` to provide `constexpr` evaluation,
         but guaranteed to preserve type.
*/
template <rational T, class S>
XTAL_DEF_(return,inline,let)
XTAL_NYM_(copysign) (T const t, S const s)
noexcept -> T
{
	using U = unsigned_case_t<T>;
	XTAL_IF0
	XTAL_0IF (sizeof(T) != sizeof(S) and rational<S>) {
		return XTAL_NYM_(copysign) (t, (T) s);
	}
	XTAL_0IF (sizeof(T) != sizeof(S) and integral<S>) {
		return XTAL_NYM_(copysign) (t, signed_cast<T>(s));
	}
	XTAL_0IF (sizeof(T) == sizeof(__builtin_copysign(t, s))) {
		return __builtin_copysign(t, s);
	}
	XTAL_0IF_(else) {
		U constexpr  positive_mask = ~U{} >> 1, sign_mask = ~positive_mask;
		U const t_ = positive_mask&bit_cast<U>(t);
		U const s_ =     sign_mask&bit_cast<U>(s);
		return bit_cast<T>(XTAL_MOV_(t_)|XTAL_MOV_(s_));
	}
};
XTAL_DEF_(let) copysign = [] XTAL_1FN_(call) (XTAL_NYM_(copysign));
static_assert(same_type_as<float, XTAL_ALL_(copysign(1.F, 1.F))>);


////////////////////////////////////////////////////////////////////////////////

template <std::floating_point F>
XTAL_DEF_(return,inline,set)
ldexp(F f, signed_case_t<F> x)
noexcept -> auto
{
	using K = bit_flop<F>;
	XTAL_IF1_(consteval) {
		return f*bit_cast<F>(K::unit + x << K::FRACTION);
	}
	XTAL_0IF_(else) {// In order of increasing speed...
	//	return std::ldexp(f, (int) x);
	//	bit_floss(f).exponent += x;
		reinterpret_cast<unsigned_case_t<F> &>(f) += x << K::FRACTION;
		return f;
	}
}


////////////////////////////////////////////////////////////////////////////////
/*!
\returns The result of `w + x*(y*...*ys)`, using `fma` where possible.
\note    May be extended via ADL.
*/
template <class T=void>
struct plus_multiplies;

template <>
struct plus_multiplies<void>
{
	XTAL_DEF_(return,inline,let)
	operator() (auto &&w, auto &&x, auto &&y) const
	noexcept -> XTAL_ALL_(w + x*y)
	{
		using Z = XTAL_ALL_(w + x*y);
		XTAL_IF0
		XTAL_0IF_(consteval) {
			return                              XTAL_REF_(y)*XTAL_REF_(x) + XTAL_REF_(w) ;
		}
	#if   XTAL_SYS_(FMA) and XTAL_SYS_(builtin)
		XTAL_0IF (requires {std::fma(y, x, w);}) {
			return static_cast<Z>(__builtin_fma(XTAL_REF_(y),XTAL_REF_(x),  XTAL_REF_(w)));
		}
	#endif
	#if   XTAL_SYS_(FMA)
		XTAL_0IF (requires {fma(y, x, w);}) {
			return static_cast<Z>(          fma(XTAL_REF_(y),XTAL_REF_(x),  XTAL_REF_(w)));
		}
	#endif
		XTAL_0IF_(else) {
			return                              XTAL_REF_(y)*XTAL_REF_(x) + XTAL_REF_(w) ;
		}
	}
	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (V const &w, std::complex<V> const &x, V const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w, x.real(), y)
		,	x.imag()*y
		};}
	}
	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (V const &w, V const &x, std::complex<V> const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w, x, y.real())
		,	x*y.imag()
		};}
	}

	template <class V>
	XTAL_DEF_(return,inline,let)
	operator() (std::complex<V> const &w, V const &x, V const &y) const
	noexcept -> std::complex<V>
	{
		XTAL_IF0
		XTAL_0IF XTAL_TRY_(to) (fma(y, x, w))
		XTAL_0IF_(else) {return {
			operator() (w.real(), x, y)
		,	w.imag()
		};}
	}

	XTAL_DEF_(return,inline,let)
	operator() (auto &&w, auto &&x, auto &&y, auto &&...ys) const
	noexcept -> auto
	requires (1 <= sizeof...(ys))
	{
		return operator() (XTAL_REF_(w), XTAL_REF_(x), (XTAL_REF_(y) *...* XTAL_REF_(ys)));
	}

};
template <class T>
struct plus_multiplies
{
	template <class W, class ...Xs>
	XTAL_DEF_(return,inline,let)
	operator() (W &&w, Xs &&...xs) const
	noexcept -> auto
	{
		static_assert((std::convertible_to<W, T> and...and std::convertible_to<Xs, T>));
		return plus_multiplies<void>{}.operator() (XTAL_REF_(w), XTAL_REF_(xs)...);
	}

};

template <class T=void> using multiplies = std::multiplies<T>;
template <class T=void> using       plus = std::      plus<T>;


////////////////////////////////////////////////////////////////////////////////

template <class T=void>
struct real
{
private:
	using U = XTAL_NOM_(T);

public:
	XTAL_DEF_(return,inline,let)
	operator() (auto &&u) const
	noexcept -> auto
	requires std::same_as<U, void> or std::same_as<U, XTAL_ALL_(u)>
	{
		std::real(XTAL_REF_(u));
	}

};
template <class T=void>
struct imag
{
private:
	using U = XTAL_NOM_(T);

public:
	XTAL_DEF_(return,inline,let)
	operator() (auto &&u) const
	noexcept -> auto
	requires std::same_as<U, void> or std::same_as<U, XTAL_ALL_(u)>
	{
		std::imag(XTAL_REF_(u));
	}

};


