////////////////////////////////////////////////////////////////////////////////

template <class T, class ..._s > XTAL_TYP_(ask)  same_as      = (...and std::same_as<          T ,           _s >);
template <class T, class ..._s > XTAL_TYP_(ask)  same_type_as = (...and std::same_as<XTAL_NOM_(T), XTAL_NOM_(_s)>);
template <class T, class ..._s > XTAL_TYP_(ask)  same_size_as = (...and                 (sizeof(T) == sizeof(_s)));


