////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

template <class Y>
XTAL_VAL_(let)
qualify_f = [] (auto &&x)
XTAL_0FN -> decltype(auto) {
	XTAL_IF0
	XTAL_0IF (  fungible_q<decltype(x), Y>) {return      static_cast<   qualify_s<decltype(x), Y>>(x);}
	XTAL_0IF (infungible_q<decltype(x), Y>) {return reinterpret_cast<   qualify_s<decltype(x), Y>>(x);}
};
template <class Y>
XTAL_VAL_(let)
disqualify_f = [] (auto &&x)
XTAL_0FN -> decltype(auto) {
	XTAL_IF0
	XTAL_0IF (  fungible_q<decltype(x), Y>) {return      static_cast<disqualify_s<decltype(x), Y>>(x);}
	XTAL_0IF (infungible_q<decltype(x), Y>) {return reinterpret_cast<disqualify_s<decltype(x), Y>>(x);}
};


////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Shaped...

XTAL_VAL_(return,inline,let)
destruct_f(auto &&t)
noexcept -> decltype(auto)
{
	using T_ref =  decltype(t);
	using T_val = XTAL_ALL_(t);
	static_assert(fixed_shaped_q<T_ref>);
	XTAL_IF0
	XTAL_0IF (tuple_shaped_q<T_ref>) {
		return XTAL_REF_(t);
	}
	XTAL_0IF (different_q<T_ref, T_val &>) {
		return   xtd::bit_cast<based_t<destruct_t<T_ref>>  >(XTAL_REF_(t));
	}
	XTAL_0IF (     same_q<T_ref, T_val &>) {
		return reinterpret_cast<        destruct_t<T_ref> &&>(XTAL_REF_(t));
	}
}
template <int N_dex>
XTAL_VAL_(return,inline,let)
destruct_f(auto &&t)
noexcept -> decltype(auto)
{
	using std::get;
	using T = decltype(t);
	static_assert(fixed_shaped_q<T>);
	auto constexpr K_ext = fixed_shaped<decltype(t)>::extent();
	auto constexpr K_dex = modulo_v<K_ext, N_dex>;
	XTAL_IF0
	XTAL_0IF XTAL_TRY_(to) (get<K_dex>(          (XTAL_REF_(t))))
	XTAL_0IF XTAL_TRY_(to) (get<K_dex>(destruct_f(XTAL_REF_(t))))
	XTAL_0IF XTAL_TRY_(to) (          (destruct_f(XTAL_REF_(t)))[K_dex])
}

template <int N, int ...Ns>
XTAL_VAL_(return,inline,let)
restruct_f(auto &&t)
noexcept
requires fixed_shaped_q<decltype(t)>
{
	auto constexpr M = fixed_shaped<decltype(t)>::extent();
	auto constexpr I = modulo_v<M, N>;
	XTAL_IF0
	XTAL_0IF (none_v<Ns...>) {return                   get<I>(destruct_f(XTAL_REF_(t))) ;}
	XTAL_0IF (some_v<Ns...>) {return restruct_f<Ns...>(get<I>(restruct_f(XTAL_REF_(t))));}
}
XTAL_VAL_(return,inline,let)
restruct_f(auto &&t)
noexcept -> decltype(auto)
requires fixed_shaped_q<decltype(t)>
{
	using T = decltype(t);
	return reinterpret_cast<restruct_t<T> &&>(XTAL_REF_(t));
}


////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Ranged...
/*!
\returns
The nearest aligned offset for type `T`,
adjusting the referenced index `i` to point to the next available argument.
*/
template <int N_dt=0, class T>
XTAL_VAL_(return,inline,let)
point_f(T &&t, int const n_dt=0)
noexcept -> auto
{
	if constexpr (iterator_q<std::decay_t<T>>) {
		return xtd::ranges::next(XTAL_REF_(t), N_dt + n_dt);
	}
	else {
		XTAL_IF0
		XTAL_0IF (0 <= N_dt) {return    point_f<N_dt>(XTAL_REF_(t).begin(), n_dt);}
		XTAL_0IF (N_dt <  0) {return    point_f<N_dt>(XTAL_REF_(t).  end(), n_dt);}
	}
}
template <int N_dt=0, class T>
XTAL_VAL_(return,inline,let)
endpoint_f(T &&t, int const n_dt=0)
noexcept -> auto
{
	if constexpr (iterator_q<std::decay_t<T>>) {
		return xtd::ranges::prev(XTAL_REF_(t), N_dt + n_dt);
	}
	else {
		XTAL_IF0
		XTAL_0IF (0 <= N_dt) {return endpoint_f<N_dt>(XTAL_REF_(t).  end(), n_dt);}
		XTAL_0IF (N_dt <  0) {return endpoint_f<N_dt>(XTAL_REF_(t).begin(), n_dt);}
	}
}
/*!
\returns
The `size` of the given range.
*/
template <integral_variable_q Y=size_type>
XTAL_VAL_(return,inline,let)
count_f(auto const &t)
noexcept -> based_t<Y>
{
	using V = based_t<Y>;
	using T = XTAL_ALL_(t);
	XTAL_IF0
	XTAL_0IF (fixed_shaped_q<T> and un_v<fluid_shaped_q<T>>) {
		return static_cast<V>(fixed_shaped<T>::extent());
	}
	XTAL_0IF_(to) (static_cast<V>(T::size()))
	XTAL_0IF_(to) (static_cast<V>(t .size()))
	XTAL_0IF_(to) (static_cast<V>(t))
	XTAL_0IF_(to) (static_cast<V>(0))
}
template <integral_variable_q Y=size_type>
XTAL_VAL_(return,inline,let)
count_f(auto const &...ts)
noexcept -> based_t<Y>
{
	return std::min<based_t<Y>>({(count_f(ts) - 1)...}) + 1;
}
XTAL_VAL_(return,inline,let) discount_f(auto const &...ts) noexcept -> decltype(auto) {return xtd::ranges::views::drop_exactly(count_f(ts...));}
XTAL_VAL_(return,inline,let)  account_f(auto const &...ts) noexcept -> decltype(auto) {return xtd::ranges::views::take_exactly(count_f(ts...));}
XTAL_VAL_(return,inline,let)  recount_f(auto const &...ts) noexcept requires in_v<fluid_shaped_q<decltype(ts)...>> {return  account_f(ts...);}
XTAL_VAL_(return,inline,let)  recount_f(auto const &...ts) noexcept requires un_v<fluid_shaped_q<decltype(ts)...>> {return discount_f(0    );}

template <counter_q I0, counter_q IN>
XTAL_VAL_(return,inline,let)
counted_f(I0 i0, IN iN)
noexcept -> auto
{
	return counted_t<common_t<I0, IN>>(i0, iN);
}

template <counter_q  I >	XTAL_VAL_(return,inline,let) counted_f(I i0, I iN) noexcept -> auto {return counted_t<I>(i0, iN);}
template <class      T >	XTAL_VAL_(return,inline,let) counted_f(T &&t)      noexcept -> auto {return counted_t<T>(XTAL_REF_(t));}
template <class      T >	XTAL_VAL_(return,inline,let) counter_f(T &&t)      noexcept -> auto {return counter_t<T>(XTAL_REF_(t));}

/*!
\returns
The `any_view` type-erased form of `y`.
*/
XTAL_VAL_(return,inline,let)
derange_f(iterable_q auto &&t)
noexcept -> auto
{
	using      T  = XTAL_ALL_(t);
	using      T_ = xtd::ranges::any_view<iteratee_t<T>, xtd::ranges::get_categories<T>()>;
	auto const n_ = recount_f(t);
	return T_{XTAL_REF_(t)}|XTAL_MOV_(n_);
}
template <iterable_q T>
using derange_t = XTAL_ALL_(derange_f(XTAL_ANY_(T)));

/*!
\returns The result of zipping `...xs` with `f(...)`.
*/
template <class F             >	requires applicative_p<F       > XTAL_VAL_(inline,let) applicative_f(F &&f            ) noexcept -> decltype(auto) {return xtd::ranges::views::  generate(XTAL_REF_(f)                  );}
template <class F, class    X >	requires applicative_p<F, X    > XTAL_VAL_(inline,let) applicative_f(F &&f, X  &&   x ) noexcept -> decltype(auto) {return xtd::ranges::views:: transform(XTAL_REF_(x), XTAL_REF_(f )   );}
template <class F, class ...Xs>	requires applicative_p<F, Xs...> XTAL_VAL_(inline,let) applicative_f(F &&f, Xs &&...xs) noexcept -> decltype(auto) {return xtd::ranges::views::  zip_with(XTAL_REF_(f), XTAL_REF_(xs)...);}
template <auto  f, class ...Xs>	                                 XTAL_VAL_(inline,let) applicative_f(       Xs &&...xs) noexcept -> decltype(auto) {return                            applicative_f(f , XTAL_REF_(xs)...);}

/*!
\returns The result of zipping `...xs` with `F{...}`.
*/
template <  complete_q F, class ...Xs>	XTAL_VAL_(inline,let) constructive_f(Xs &&...xs) noexcept -> decltype(auto) {return applicative_f([] XTAL_1FN_(make) (F), XTAL_REF_(xs)...);}
template <incomplete_q F, class ...Xs>	XTAL_VAL_(inline,let) constructive_f(Xs &&...xs) noexcept -> decltype(auto) {return               xtd::ranges::views::zip(XTAL_REF_(xs)...);}


