template <          class ..._s>	XTAL_TYP_(ask)           interval_q	= (some_q<_s...> and...and _retail::     interval_q<_s>);
template <          class ..._s>	XTAL_TYP_(ask)            counted_q	= (some_q<_s...> and...and _retail::      counted_q<_s>);
template <          class ..._s>	XTAL_TYP_(ask)            counter_q	= (some_q<_s...> and...and _retail::      counter_q<_s>);
template <class  T=extent_type >	XTAL_TYP_(let)            counted_t	=                          _retail::      counted_t<T >;
template <class  T=extent_type >	XTAL_TYP_(let)            counter_t	=                          _retail::      counter_t<T >;

/*!
\brief
Determines whether `...xs` can be zipped with `f`.
*/
template <class F, class ...Xs>
concept inapplicative_p = incomplete_q<F>
or same_q<F, std::tuple<std::remove_cvref_t<xtd::ranges::range_reference_t<Xs>>...>>
or same_q<F, std::pair <std::remove_cvref_t<xtd::ranges::range_reference_t<Xs>>...>>;

template <class F, class ...Xs>
concept   applicative_p = not inapplicative_p<F, Xs...>
and std::invocable<F, xtd::ranges::range_reference_t<Xs> ...>;


