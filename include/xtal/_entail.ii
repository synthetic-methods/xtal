// Structural...

using _retail::     isotropic_t;
using _retail::     epitropic_t;
using _retail::    isomorphic_t;
using _retail::    epimorphic_t;

using _retail::     isotropic_q;///< `Ts` are         the same modulo qualifiers.
using _retail::     epitropic_q;///< `Ts` are interconvertible modulo qualifiers.
using _retail::    isomorphic_q;///< `Ts` are `isotropic` or `isotropic<value_type>`.
using _retail::    epimorphic_q;///< `Ts` are `epitropic` or `epitropic<value_type>`.

using _retail::      fungible_q;///< `T` and `Ts...` are     related by inheritance.
using _retail::    infungible_q;///< `T` and `Ts...` are not related by inheritance.

using _retail::          some_q;///< `1 <= sizeof...(Ts)`
using _retail::          none_q;///< `0 == sizeof...(Ts)`
using _retail::          some_v;///< `1 <= sizeof...(Ns)`
using _retail::          none_v;///< `0 == sizeof...(Ns)`

using _retail::        either_t;
using _retail::        either_q;
using _retail::        common_t;
using _retail::        common_q;

template <          class ..._s>	XTAL_TYP_(new)              based     {using type =   common_t<_retail::        based_t<_s>...>;};
template <class  T             >	XTAL_TYP_(new)              based<T>  {using type =            _retail::        based_t<T >    ;};
template <          class ..._s>	XTAL_TYP_(let)              based_t	=  typename based<_s...>::type;
template <          class ..._s>	XTAL_TYP_(ask)              based_q	= (some_q<_s...> and...and _retail::        based_q<_s    >);
template <          class ..._s>	XTAL_TYP_(ask)            unbased_q	= (some_q<_s...> and...and _retail::      unbased_q<_s    >);

template <          class ..._s>	XTAL_TYP_(let)           complete_t	=                          _retail::     complete_t<_s...>;
template <          class ..._s>	XTAL_TYP_(ask)           complete_q	= (some_q<_s...> and...and _retail::     complete_q<_s   >);
template <          class ..._s>	XTAL_TYP_(ask)         incomplete_q	= (some_q<_s...> and...and _retail::   incomplete_q<_s   >) or  none_q<_s...>;

template <          class ..._s>	XTAL_TYP_(ask)             atomic_q	= (some_q<_s...> and...and _retail::       atomic_q<_s   >);
template <          class ..._s>	XTAL_TYP_(ask)          molecular_q	= (some_q<_s...> and...and _retail::    molecular_q<_s   >);
template <          class ..._s>	XTAL_TYP_(ask)       submolecular_q	= (some_q<_s...> and...and _retail:: submolecular_q<_s   >);

using _retail::     different_v;///< `Ns...` are different values.
using _retail::          same_v;///< `Ns...` are identical values.
using _retail::     different_q;///< `Ts...` are different modulo qualifiers.
using _retail::          same_q;///< `Ts...` are identical modulo qualifiers.
using _retail::          make_q;///< `Ts...` are constructible from `Ts[0]`.
using _retail::          make_p;///< `T` is constructible from `Ts...`.

using _retail::       qualify_s;///< Applies the qualifiers on `S` to `T`.
using _retail::    disqualify_s;///< Applies the qualifiers on `S` to `T`.


