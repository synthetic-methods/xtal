template <auto   N> XTAL_VAL_(return,inline,let)        exvariable_f(std::in_place_index_t<N>) noexcept -> ordinal_constant_t<xtd::signed_cast(N)> {return {};}
template <auto   N> XTAL_VAL_(return,inline,let)        envariable_f(std::in_place_index_t<N>) noexcept -> logical_constant_t<1> {return {};}
template <class  Z> XTAL_VAL_(return,inline,let)        envariable_f(std::in_place_type_t <Z>) noexcept -> logical_constant_t<1> {return {};}
                    XTAL_VAL_(return,inline,let)        envariable_f(std::in_place_t         ) noexcept -> logical_constant_t<1> {return {};}
                    XTAL_VAL_(return,inline,let)        envariable_f(auto                    ) noexcept -> logical_constant_t<0> {return {};}
template <class  T> XTAL_VAL_(return,inline,let)        invariable_f(T                       ) noexcept -> std::negation<XTAL_ALL_(envariable_f(XTAL_ANY_(T)))> {return {};}
template <class  T> XTAL_VAL_(let)                      exvariable_v = XTAL_ALL_(exvariable_f(XTAL_ANY_(T)))::value;
template <class  T> XTAL_VAL_(let)                      envariable_v = XTAL_ALL_(envariable_f(XTAL_ANY_(T)))::value;
template <class  T> XTAL_VAL_(let)                      invariable_v = XTAL_ALL_(invariable_f(XTAL_ANY_(T)))::value;
//NOTE: Avoid using `(?:ex|en|in)variable_q` in LLVM 16...
template <          class ..._s>	XTAL_TYP_(ask)         exvariable_q	= (some_q<_s...> and...and requires         {exvariable_f(XTAL_ANY_(_s));});
template <          class ..._s>	XTAL_TYP_(ask)         envariable_q	= (some_q<_s...> and...and                   envariable_v<based_t<_s>>);
template <          class ..._s>	XTAL_TYP_(ask)         invariable_q	= (some_q<_s...> and...and                   invariable_v<based_t<_s>>);
template <          class ..._s>	XTAL_TYP_(ask)           variable_q	= (some_q<_s...> and...and _retail::           variable_q<based_t<_s>>);
template <          class ..._s>	XTAL_TYP_(ask)           constant_q	= (some_q<_s...> and...and _retail::           constant_q<based_t<_s>>);
