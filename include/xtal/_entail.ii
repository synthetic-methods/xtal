template <          class ..._s>	XTAL_TYP_(ask)         reiterated_q	= (some_q<_s...> and...and _retail::   reiterated_q<_s>);
template <          class ..._s>	XTAL_TYP_(ask)           iterable_q	= (some_q<_s...> and...and _retail::     iterable_q<_s>);
template <          class ..._s>	XTAL_TYP_(ask)           iterated_q	= (some_q<_s...> and...and _retail::     iterated_q<_s>);
template <          class ..._s>	XTAL_TYP_(ask)           iterator_q	= (some_q<_s...> and...and _retail::     iterator_q<_s>);
