using _retail::    applicable_p;
using _retail::  inapplicable_p;
template <          class ..._s>	XTAL_TYP_(ask)         applicable_q	= (some_q<_s...> and...and _retail::   applicable_q<   _s   >);
template <          class ..._s>	XTAL_TYP_(ask)       inapplicable_q	= (some_q<_s...> and...and _retail:: inapplicable_q<   _s   >);
template <class  X, class ..._s>	XTAL_TYP_(ask)       automorphism_q	= (some_q<_s...> and...and _retail:: automorphism_q<X, _s   >);///< `X `  is unchanged by `Fs...`.
template <class  F, class ..._s>	XTAL_TYP_(ask)       automorphism_p	= (some_q<_s...> and...and _retail:: automorphism_p<F, _s   >);///< `Xs` are unchanged by `F ...`.


