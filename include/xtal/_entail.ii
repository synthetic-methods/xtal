/*!
\brief
Provides a suitable `initializer_list::value_type` for `T` (defaulting to itself).

\note
If `T` has fixed-size and responds to both `[](unsigned)` and `()(unsigned)`,
the return value of the latter is used.
*/
template <class T             >	XTAL_TYP_(new)        initializer    {using type = typename fluid<T>::value_type;};
template <reexpressed_q T     >	XTAL_TYP_(new)        initializer<T> {using type = based_t<expressee_t<T>>;};
template <class T             >	XTAL_TYP_(let)        initializer_t	= typename initializer<T>::type;
template <class T             >	XTAL_TYP_(ask)        initializer_q	= different_q<T, initializer_t<T>> and indexed_q<T>;// or reexpressed_q<T>);

